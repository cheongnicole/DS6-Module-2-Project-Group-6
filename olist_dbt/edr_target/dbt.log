{"data": {"conn_name": "macro_log_macro_results", "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.10.9\", \"profile_name\": \"elementary\", \"target_name\": \"default\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \n    /* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"elementary_component\": \"OSS\", \"invocation_id\": \"61671145-d4f3-48a5-b7cc-4cfb77a7638a\", \"package_name\": \"elementary\", \"resource_name\": \"log_macro_results\", \"resource_type\": \"macro\"} --END-ELEMENTARY-METADATA-- */\n    \n              with dbt_artifacts_exposures as (\n                select\n                  name,\n                  \n                    label,\n                  \n                  unique_id,\n                  url,\n                  type,\n                  maturity,\n                  owner_email,\n                  owner_name as owners,\n                  tags,\n                  package_name,\n                  description,\n                  meta,\n                  original_path as full_path,\n                  \n                    raw_queries,\n                  \n                  depends_on_nodes,\n                  \n                    depends_on_columns\n                  \n\n                from `project-7781a5d3-3f4e-4cd5-a43`.`olist_dev_elementary`.`dbt_exposures`\n              )\n\n             select * from dbt_artifacts_exposures\n        \n\n  "}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "61671145-d4f3-48a5-b7cc-4cfb77a7638a", "level": "debug", "msg": "On macro_log_macro_results: /* {\"app\": \"dbt\", \"dbt_version\": \"1.10.9\", \"profile_name\": \"elementary\", \"target_name\": \"default\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \n    /* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"elementary_component\": \"OSS\", \"invocation_id\": \"61671145-d4f3-48a5-b7cc-4cfb77a7638a\", \"package_name\": \"elementary\", \"resource_name\": \"log_macro_results\", \"resource_type\": \"macro\"} --END-ELEMENTARY-METADATA-- */\n    \n              with dbt_artifacts_exposures as (\n                select\n                  name,\n                  \n                    label,\n                  \n                  unique_id,\n                  url,\n                  type,\n                  maturity,\n                  owner_email,\n                  owner_name as owners,\n                  tags,\n                  package_name,\n                  description,\n                  meta,\n                  original_path as full_path,\n                  \n                    raw_queries,\n                  \n                  depends_on_nodes,\n                  \n                    depends_on_columns\n                  \n\n                from `project-7781a5d3-3f4e-4cd5-a43`.`olist_dev_elementary`.`dbt_exposures`\n              )\n\n             select * from dbt_artifacts_exposures\n        \n\n  ", "name": "SQLQuery", "pid": 2174, "thread": "MainThread", "ts": "2026-09-10T04:42:39.232119Z"}}
